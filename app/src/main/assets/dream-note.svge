<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg"
     xmlns:app="https://sausage.dev/ns/app/1"
     viewBox="0 0 390 340"
     width="100%"
     height="100%"
     preserveAspectRatio="xMidYMid meet">
  <metadata>
    <app:manifest
        id="dev.sausage.dream-note"
        name="Dream Note"
        version="0.0.1"
        profile-version="1" />
    <app:screen id="note">
      <app:graphic ref="dream-header" />
      <app:text-area
          key="dream-note.body"
          label="What do you remember?"
          hint="A real browser text field—selection, clipboard and keyboard included."
          placeholder="A place, a feeling, a strange detail..." />
      <app:choice
          key="dream-note.vividness"
          label="How vivid was it?"
          options="Faint,Clear,Brilliant" />
      <app:switch
          key="dream-note.lucid"
          label="I knew I was dreaming" />
      <app:slider
          key="dream-note.intensity"
          label="How intense did it feel?"
          min="0"
          max="10"
          step="1"
          value="5" />
      <app:button label="Hold this dream" action="captureDream" />
      <app:graphic ref="dream-confirmation" />
      <app:button label="Review this dream" target-screen="review" />
    </app:screen>
    <app:screen id="review">
      <app:graphic ref="dream-review" />
      <app:button label="Return to note" target-screen="note" />
    </app:screen>
  </metadata>

  <defs>
    <linearGradient id="night" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#07101e" />
      <stop offset="0.58" stop-color="#10243b" />
      <stop offset="1" stop-color="#1c3652" />
    </linearGradient>
    <radialGradient id="dream-glow" cx="50%" cy="50%" r="50%">
      <stop offset="0" stop-color="#f8dba8" stop-opacity="0.48" />
      <stop offset="1" stop-color="#f8dba8" stop-opacity="0" />
    </radialGradient>
    <filter id="blur">
      <feGaussianBlur stdDeviation="9" />
    </filter>
  </defs>

  <style>
    text {
      font-family: Inter, Roboto, Arial, sans-serif;
      text-rendering: geometricPrecision;
    }
    .star-a { animation: twinkle 3.4s ease-in-out infinite; }
    .star-b { animation: twinkle 4.1s 800ms ease-in-out infinite; }
    #orbit {
      transform-box: fill-box;
      transform-origin: center;
      animation: breathe 4.6s ease-in-out infinite;
    }
    #vividness-glow {
      opacity: .1;
      transform-box: fill-box;
      transform-origin: center;
      transition: opacity 320ms ease, transform 320ms ease;
    }
    #dream-header[data-vividness="Faint"] #vividness-glow {
      opacity: .18;
      transform: scale(.96);
    }
    #dream-header[data-vividness="Clear"] #vividness-glow {
      opacity: .42;
      transform: scale(1.03);
    }
    #dream-header[data-vividness="Brilliant"] #vividness-glow {
      opacity: .72;
      transform: scale(1.1);
    }
    #vividness-status { transition: fill 240ms ease; }
    #dream-header[data-vividness="Clear"] #vividness-status { fill: #f8dba8; }
    #dream-header[data-vividness="Brilliant"] #vividness-status { fill: #fff4d6; }
    #lucid-aura {
      opacity: 0;
      transform-box: fill-box;
      transform-origin: center;
      transition: opacity 280ms ease;
    }
    #dream-header[data-lucid="true"] #lucid-aura {
      opacity: .82;
      animation: lucid-turn 12s linear infinite;
    }
    #intensity-ring {
      opacity: .18;
      transform-box: fill-box;
      transform-origin: center;
      transition: opacity 100ms linear, transform 100ms linear;
    }
    #capture-burst {
      opacity: 0;
      transform-box: fill-box;
      transform-origin: center;
    }
    #dream-header.captured #capture-burst {
      animation: capture-burst 900ms cubic-bezier(.2, .85, .24, 1);
    }
    #dream-header.captured #orbit {
      animation: capture-orbit 900ms cubic-bezier(.2, .85, .24, 1);
    }
    #dream-confirmation .confirmation-ready,
    #dream-confirmation .confirmation-held,
    #dream-confirmation .confirmation-rings {
      transform-box: fill-box;
      transform-origin: center;
    }
    #dream-confirmation .confirmation-held { opacity: 0; }
    #dream-confirmation .confirmation-rings { opacity: 0.2; }
    #dream-confirmation.confirmed .confirmation-ready {
      animation: confirmation-out 500ms ease forwards;
    }
    #dream-confirmation.confirmed .confirmation-held {
      animation: confirmation-in 700ms 180ms cubic-bezier(.2, .85, .24, 1) forwards;
    }
    #dream-confirmation.confirmed .confirmation-rings {
      animation: confirmation-rings 950ms cubic-bezier(.2, .85, .24, 1);
    }
    #dream-review .review-orbit {
      transform-box: fill-box;
      transform-origin: center;
      animation: review-breathe 5.2s ease-in-out infinite;
    }
    @keyframes twinkle {
      0%, 100% { opacity: .22; }
      50% { opacity: .9; }
    }
    @keyframes breathe {
      0%, 100% { transform: translateY(0) scale(1); }
      50% { transform: translateY(-4px) scale(1.025); }
    }
    @keyframes capture-burst {
      0% { opacity: 0; transform: scale(.55) rotate(-8deg); }
      24% { opacity: 1; }
      72% { opacity: .78; }
      100% { opacity: 0; transform: scale(1.42) rotate(8deg); }
    }
    @keyframes lucid-turn {
      to { transform: rotate(360deg); }
    }
    @keyframes capture-orbit {
      0% { transform: scale(1); }
      35% { transform: scale(.9); }
      68% { transform: scale(1.09); }
      100% { transform: scale(1); }
    }
    @keyframes confirmation-out {
      to { opacity: 0; transform: translateY(-7px); }
    }
    @keyframes confirmation-in {
      0% { opacity: 0; transform: translateY(12px) scale(.98); }
      100% { opacity: 1; transform: translateY(0) scale(1); }
    }
    @keyframes confirmation-rings {
      0% { opacity: .2; transform: scale(.78); }
      42% { opacity: .82; }
      100% { opacity: .2; transform: scale(1.18); }
    }
    @keyframes review-breathe {
      0%, 100% { transform: translateY(0) scale(1); opacity: .72; }
      50% { transform: translateY(-3px) scale(1.035); opacity: 1; }
    }
    @media (prefers-reduced-motion: reduce) {
      .star-a, .star-b, #orbit, #capture-burst, #lucid-aura,
      .confirmation-ready, .confirmation-held, .confirmation-rings,
      .review-orbit { animation: none !important; }
      #vividness-glow, #vividness-status, #intensity-ring { transition: none; }
      #dream-confirmation.confirmed .confirmation-ready { opacity: 0; }
      #dream-confirmation.confirmed .confirmation-held { opacity: 1; }
    }
  </style>

  <g id="dream-header">
    <rect width="390" height="340" fill="url(#night)" />

    <g fill="#dbeaff">
      <circle class="star-a" cx="44" cy="72" r="1.2" />
      <circle class="star-b" cx="89" cy="118" r="1.7" />
      <circle class="star-a" cx="319" cy="67" r="1.5" />
      <circle class="star-b" cx="354" cy="142" r="1.1" />
      <circle class="star-a" cx="287" cy="183" r="1.1" />
    </g>

    <text x="24" y="45" fill="#9fb5cf" font-size="10" font-weight="700" letter-spacing="2.8">DREAM NOTE</text>
    <rect x="299" y="27" width="67" height="27" rx="13.5" fill="#ffffff" opacity="0.08" />
    <text id="vividness-status" x="332.5" y="45" fill="#c9d9eb" font-size="8" font-weight="700" text-anchor="middle" letter-spacing="0.8">NOW</text>

    <circle id="vividness-glow" cx="195" cy="141" r="91" fill="#f8dba8" filter="url(#blur)" pointer-events="none" />
    <circle id="intensity-ring" cx="195" cy="141" r="75" fill="none" stroke="#efaa65" stroke-width="1.5" pointer-events="none" />
    <g id="lucid-aura" fill="#fff4d6" pointer-events="none">
      <path d="M195 58 L198 64 L204 67 L198 70 L195 76 L192 70 L186 67 L192 64 Z" />
      <path d="M278 141 L284 144 L287 150 L290 144 L296 141 L290 138 L287 132 L284 138 Z" />
      <path d="M195 206 L198 212 L204 215 L198 218 L195 224 L192 218 L186 215 L192 212 Z" />
      <path d="M94 141 L100 144 L103 150 L106 144 L112 141 L106 138 L103 132 L100 138 Z" />
      <circle cx="239" cy="71" r="2" />
      <circle cx="267" cy="185" r="2" />
      <circle cx="151" cy="211" r="2" />
      <circle cx="123" cy="97" r="2" />
    </g>
    <g id="orbit">
      <circle cx="195" cy="141" r="92" fill="url(#dream-glow)" opacity="0.72" filter="url(#blur)" />
      <circle cx="195" cy="141" r="61" fill="#f6d89f" opacity="0.1" />
      <circle cx="195" cy="141" r="43" fill="#fff4d6" opacity="0.92" />
      <circle cx="210" cy="128" r="42" fill="#112944" />
      <path d="M156 170 C172 180, 215 182, 234 163" fill="none" stroke="#efaa65" stroke-width="2" stroke-linecap="round" opacity="0.7" />
    </g>

    <g id="capture-burst" fill="none" stroke-linecap="round" pointer-events="none">
      <circle cx="195" cy="141" r="70" stroke="#efaa65" stroke-width="2" opacity="0.9" />
      <circle cx="195" cy="141" r="82" stroke="#dbeaff" stroke-width="1" stroke-dasharray="3 9" opacity="0.72" />
      <path d="M195 45 V62 M195 220 V237 M99 141 H116 M274 141 H291"
            stroke="#f8dba8" stroke-width="3" />
      <path d="M127 73 L139 85 M251 197 L263 209 M263 73 L251 85 M139 197 L127 209"
            stroke="#dbeaff" stroke-width="2" />
    </g>

    <text x="195" y="246" fill="#f7f1e7" font-size="27" font-weight="700" text-anchor="middle">Catch it before it fades.</text>
    <text x="195" y="278" fill="#9fb5cf" font-size="13" text-anchor="middle">Write freely. You can make sense of it later.</text>

    <path d="M0 318 C88 294, 142 333, 220 314 C285 298, 337 302, 390 319 L390 340 L0 340 Z"
          fill="#07101e" opacity="0.7" />
    <path d="M0 329 C72 309, 151 343, 230 323 C299 306, 350 317, 390 328"
          fill="none" stroke="#efaa65" stroke-width="1.5" opacity="0.32" />
  </g>

  <g id="dream-confirmation" aria-label="Dream note confirmation, ready when you are">
    <rect width="390" height="340" fill="#07101e" />
    <circle cx="195" cy="151" r="82" fill="url(#dream-glow)" opacity="0.34" filter="url(#blur)" />

    <g class="confirmation-rings" fill="none" stroke-linecap="round">
      <circle cx="195" cy="151" r="62" stroke="#efaa65" stroke-width="1.5" />
      <circle cx="195" cy="151" r="74" stroke="#dbeaff" stroke-width="1" stroke-dasharray="2 8" />
    </g>

    <path d="M165 151 C176 166, 184 173, 195 179 C206 173, 214 166, 225 151
             C225 127, 213 116, 195 116 C177 116, 165 127, 165 151 Z"
          fill="#f6d89f" opacity="0.13" />
    <path d="M176 144 C183 149, 189 155, 195 164 C201 155, 207 149, 214 144"
          fill="none" stroke="#f8dba8" stroke-width="3" stroke-linecap="round" />
    <circle cx="195" cy="133" r="6" fill="#fff4d6" />

    <g class="confirmation-ready">
      <text x="195" y="245" fill="#f7f1e7" font-size="25" font-weight="700" text-anchor="middle">Ready when you are.</text>
      <text x="195" y="274" fill="#9fb5cf" font-size="12" text-anchor="middle">A quiet place is waiting for this memory.</text>
    </g>
    <g class="confirmation-held">
      <text x="195" y="245" fill="#f7f1e7" font-size="25" font-weight="700" text-anchor="middle">Dream held safely.</text>
      <text x="195" y="274" fill="#9fb5cf" font-size="12" text-anchor="middle">You can return whenever another detail surfaces.</text>
    </g>
  </g>

  <g id="dream-review" aria-label="Dream review screen">
    <rect width="390" height="340" fill="url(#night)" />
    <circle cx="195" cy="137" r="96" fill="url(#dream-glow)" opacity="0.26" filter="url(#blur)" />

    <text x="24" y="45" fill="#9fb5cf" font-size="10" font-weight="700" letter-spacing="2.8">DREAM REVIEW</text>
    <text x="366" y="45" fill="#c9d9eb" font-size="9" font-weight="700" text-anchor="end" letter-spacing="1">KEPT</text>

    <g class="review-orbit">
      <circle cx="195" cy="137" r="69" fill="#ffffff" opacity="0.045" />
      <circle cx="195" cy="137" r="57" fill="none" stroke="#efaa65" stroke-width="1.5" opacity="0.55" />
      <path d="M166 109 H215 C222 109 227 114 227 121 V169
               C227 162 222 158 215 158 H166 Z"
            fill="#fff4d6" opacity="0.94" />
      <path d="M195 109 V158" stroke="#d5915e" stroke-width="2" opacity="0.65" />
      <path d="M174 121 H187 M174 131 H187 M203 121 H218 M203 131 H218"
            stroke="#9e7959" stroke-width="1.5" stroke-linecap="round" opacity="0.64" />
      <circle cx="229" cy="103" r="5" fill="#f8dba8" />
    </g>

    <text x="195" y="244" fill="#f7f1e7" font-size="27" font-weight="700" text-anchor="middle">A memory kept.</text>
    <text id="review-word-count" x="195" y="263" fill="#9fb5cf" font-size="12" text-anchor="middle">Hold this dream to see what you caught.</text>
    <text id="review-intensity" x="195" y="282" fill="#7893b2" font-size="11" font-weight="700" text-anchor="middle">Intensity awaits</text>
    <text id="review-history" x="195" y="300" fill="#7893b2" font-size="10" font-weight="700" text-anchor="middle">Opening journal…</text>
    <path d="M70 318 H320" stroke="#dbeaff" stroke-width="1" opacity="0.12" />
  </g>

  <script type="application/ecmascript"><![CDATA[
    (() => {
      let journalReady = Promise.resolve();
      let journalError = null;
      let journalCount = 0;

      const refreshJournalCount = async () => {
        const rows = await window.sausage.db.query(
          'SELECT COUNT(*) AS count FROM dream_entries WHERE id > ?',
          [0]
        );
        if (rows.length !== 1 || !Number.isSafeInteger(rows[0].count)) {
          throw new Error('Dream journal returned an invalid entry count.');
        }
        journalCount = rows[0].count;
        const label = journalCount === 1
          ? '1 dream held in this journal'
          : `${journalCount} dreams held in this journal`;
        document.getElementById('review-history').textContent = label;
        return label;
      };

      window.addEventListener('sausage-ready', () => {
        const header = document.getElementById('dream-header');
        const status = document.getElementById('vividness-status');
        const intensityRing = document.getElementById('intensity-ring');
        const controls = window.sausage.controls;
        let vividness = controls.getValue('dream-note.vividness');
        let lucid = controls.getValue('dream-note.lucid');
        let intensity = controls.getValue('dream-note.intensity');
        const updateHeaderState = () => {
          if (vividness == null) {
            header.removeAttribute('data-vividness');
            status.textContent = 'NOW';
          } else {
            header.setAttribute('data-vividness', vividness);
            status.textContent = vividness.toUpperCase();
          }
          if (lucid) {
            header.setAttribute('data-lucid', 'true');
          } else {
            header.removeAttribute('data-lucid');
          }
          const intensityRatio = intensity / 10;
          intensityRing.style.opacity = String(0.12 + intensityRatio * 0.58);
          intensityRing.style.transform = `scale(${0.9 + intensityRatio * 0.24})`;
          const description = ['Dream note'];
          if (vividness != null) description.push(`${vividness.toLowerCase()} vividness`);
          description.push(lucid ? 'lucid' : 'not lucid');
          description.push(`intensity ${intensity} of 10`);
          header.setAttribute('aria-label', description.join(', '));
        };

        updateHeaderState();
        controls.onChange('dream-note.vividness', (value) => {
          vividness = value;
          updateHeaderState();
        });
        controls.onChange('dream-note.lucid', (value) => {
          lucid = value;
          updateHeaderState();
        });
        controls.onChange('dream-note.intensity', (value) => {
          intensity = value;
          updateHeaderState();
        });

        journalReady = (async () => {
          await window.sausage.db.execute(`
            CREATE TABLE IF NOT EXISTS dream_entries (
              id INTEGER PRIMARY KEY AUTOINCREMENT,
              body TEXT NOT NULL,
              vividness TEXT,
              lucid INTEGER NOT NULL,
              intensity REAL NOT NULL,
              created_at INTEGER NOT NULL
            )
          `);
          await refreshJournalCount();
        })().catch((error) => {
          journalError = error;
          document.getElementById('review-history').textContent = 'Journal unavailable';
          console.error('Could not open the dream journal database', error);
        });
      }, { once: true });

      window.captureDream = async () => {
        const header = document.getElementById('dream-header');
        const confirmation = document.getElementById('dream-confirmation');
        const review = document.getElementById('dream-review');
        const reviewWordCount = document.getElementById('review-word-count');
        const reviewIntensity = document.getElementById('review-intensity');
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const note = window.sausage.controls.getValue('dream-note.body').trim();
        const vividness = window.sausage.controls.getValue('dream-note.vividness');
        const lucid = window.sausage.controls.getValue('dream-note.lucid');
        const intensity = window.sausage.controls.getValue('dream-note.intensity');
        const wordCount = note === '' ? 0 : note.split(/\s+/u).length;
        const wordLabel = wordCount === 1 ? '1 word' : `${wordCount} words`;
        const vividnessLabel = vividness == null ? 'Vividness not chosen' : `${vividness} memory`;
        const lucidityLabel = lucid ? 'Lucid' : 'Not lucid';
        const reviewSummary = `${wordLabel} · ${vividnessLabel} · ${lucidityLabel}`;

        await journalReady;
        if (journalError) throw journalError;
        const write = await window.sausage.db.execute(
          `INSERT INTO dream_entries
             (body, vividness, lucid, intensity, created_at)
           VALUES (?, ?, ?, ?, ?)`,
          [note, vividness, lucid, intensity, Date.now()]
        );
        if (write.changes !== 1 || !Number.isSafeInteger(write.lastInsertId)) {
          throw new Error('Dream journal did not save exactly one entry.');
        }
        const journalLabel = await refreshJournalCount();

        reviewWordCount.textContent = reviewSummary;
        reviewIntensity.textContent = `Intensity ${intensity} of 10`;
        review.setAttribute(
          'aria-label',
          `Dream review, ${wordLabel}, ${vividnessLabel.toLowerCase()}, ${lucidityLabel.toLowerCase()}, intensity ${intensity} of 10, ${journalLabel}`
        );

        header.scrollIntoView({
          behavior: reducedMotion ? 'auto' : 'smooth',
          block: 'start'
        });

        return new Promise((resolve) => {
          window.setTimeout(() => {
            header.classList.remove('captured');
            void header.getBoundingClientRect();
            header.classList.add('captured');
            window.setTimeout(() => {
              header.classList.remove('captured');
              confirmation.classList.remove('confirmed');
              void confirmation.getBoundingClientRect();
              confirmation.classList.add('confirmed');
              confirmation.setAttribute('aria-label', 'Dream held safely');
              confirmation.scrollIntoView({
                behavior: reducedMotion ? 'auto' : 'smooth',
                block: 'start'
              });
              window.setTimeout(
                () => resolve('Dream held safely'),
                reducedMotion ? 0 : 700
              );
            }, reducedMotion ? 0 : 900);
          }, reducedMotion ? 0 : 260);
        });
      };
    })();
  ]]></script>
</svg>
