<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg"
     xmlns:app="https://sausage.dev/ns/app/1"
     viewBox="0 0 390 340"
     width="100%"
     height="100%"
     preserveAspectRatio="xMidYMid meet">
  <metadata>
    <app:manifest
        id="dev.sausage.dream-note"
        name="Dream Note"
        version="0.0.1"
        profile-version="1" />
    <app:screen id="note">
      <app:graphic ref="dream-header" />
      <app:text-area
          key="dream-note.body"
          label="What do you remember?"
          hint="A real browser text field—selection, clipboard and keyboard included."
          placeholder="A place, a feeling, a strange detail..." />
      <app:button label="Hold this dream" action="captureDream" />
    </app:screen>
  </metadata>

  <defs>
    <linearGradient id="night" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#07101e" />
      <stop offset="0.58" stop-color="#10243b" />
      <stop offset="1" stop-color="#1c3652" />
    </linearGradient>
    <radialGradient id="dream-glow" cx="50%" cy="50%" r="50%">
      <stop offset="0" stop-color="#f8dba8" stop-opacity="0.48" />
      <stop offset="1" stop-color="#f8dba8" stop-opacity="0" />
    </radialGradient>
    <filter id="blur">
      <feGaussianBlur stdDeviation="9" />
    </filter>
  </defs>

  <style>
    text {
      font-family: Inter, Roboto, Arial, sans-serif;
      text-rendering: geometricPrecision;
    }
    .star-a { animation: twinkle 3.4s ease-in-out infinite; }
    .star-b { animation: twinkle 4.1s 800ms ease-in-out infinite; }
    #orbit {
      transform-box: fill-box;
      transform-origin: center;
      animation: breathe 4.6s ease-in-out infinite;
    }
    #capture-burst {
      opacity: 0;
      transform-box: fill-box;
      transform-origin: center;
    }
    #dream-header.captured #capture-burst {
      animation: capture-burst 900ms cubic-bezier(.2, .85, .24, 1);
    }
    #dream-header.captured #orbit {
      animation: capture-orbit 900ms cubic-bezier(.2, .85, .24, 1);
    }
    @keyframes twinkle {
      0%, 100% { opacity: .22; }
      50% { opacity: .9; }
    }
    @keyframes breathe {
      0%, 100% { transform: translateY(0) scale(1); }
      50% { transform: translateY(-4px) scale(1.025); }
    }
    @keyframes capture-burst {
      0% { opacity: 0; transform: scale(.55) rotate(-8deg); }
      24% { opacity: 1; }
      72% { opacity: .78; }
      100% { opacity: 0; transform: scale(1.42) rotate(8deg); }
    }
    @keyframes capture-orbit {
      0% { transform: scale(1); }
      35% { transform: scale(.9); }
      68% { transform: scale(1.09); }
      100% { transform: scale(1); }
    }
    @media (prefers-reduced-motion: reduce) {
      .star-a, .star-b, #orbit, #capture-burst { animation: none; }
    }
  </style>

  <g id="dream-header">
    <rect width="390" height="340" fill="url(#night)" />

    <g fill="#dbeaff">
      <circle class="star-a" cx="44" cy="72" r="1.2" />
      <circle class="star-b" cx="89" cy="118" r="1.7" />
      <circle class="star-a" cx="319" cy="67" r="1.5" />
      <circle class="star-b" cx="354" cy="142" r="1.1" />
      <circle class="star-a" cx="287" cy="183" r="1.1" />
    </g>

    <text x="24" y="45" fill="#9fb5cf" font-size="10" font-weight="700" letter-spacing="2.8">DREAM NOTE</text>
    <rect x="315" y="27" width="51" height="27" rx="13.5" fill="#ffffff" opacity="0.08" />
    <text x="340.5" y="45" fill="#c9d9eb" font-size="9" font-weight="700" text-anchor="middle" letter-spacing="1">NOW</text>

    <g id="orbit">
      <circle cx="195" cy="141" r="92" fill="url(#dream-glow)" opacity="0.72" filter="url(#blur)" />
      <circle cx="195" cy="141" r="61" fill="#f6d89f" opacity="0.1" />
      <circle cx="195" cy="141" r="43" fill="#fff4d6" opacity="0.92" />
      <circle cx="210" cy="128" r="42" fill="#112944" />
      <path d="M156 170 C172 180, 215 182, 234 163" fill="none" stroke="#efaa65" stroke-width="2" stroke-linecap="round" opacity="0.7" />
    </g>

    <g id="capture-burst" fill="none" stroke-linecap="round" pointer-events="none">
      <circle cx="195" cy="141" r="70" stroke="#efaa65" stroke-width="2" opacity="0.9" />
      <circle cx="195" cy="141" r="82" stroke="#dbeaff" stroke-width="1" stroke-dasharray="3 9" opacity="0.72" />
      <path d="M195 45 V62 M195 220 V237 M99 141 H116 M274 141 H291"
            stroke="#f8dba8" stroke-width="3" />
      <path d="M127 73 L139 85 M251 197 L263 209 M263 73 L251 85 M139 197 L127 209"
            stroke="#dbeaff" stroke-width="2" />
    </g>

    <text x="195" y="246" fill="#f7f1e7" font-size="27" font-weight="700" text-anchor="middle">Catch it before it fades.</text>
    <text x="195" y="278" fill="#9fb5cf" font-size="13" text-anchor="middle">Write freely. You can make sense of it later.</text>

    <path d="M0 318 C88 294, 142 333, 220 314 C285 298, 337 302, 390 319 L390 340 L0 340 Z"
          fill="#07101e" opacity="0.7" />
    <path d="M0 329 C72 309, 151 343, 230 323 C299 306, 350 317, 390 328"
          fill="none" stroke="#efaa65" stroke-width="1.5" opacity="0.32" />
  </g>

  <script type="application/ecmascript"><![CDATA[
    (() => {
      window.captureDream = () => {
        const header = document.getElementById('dream-header');
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        header.scrollIntoView({
          behavior: reducedMotion ? 'auto' : 'smooth',
          block: 'start'
        });

        return new Promise((resolve) => {
          window.setTimeout(() => {
            header.classList.remove('captured');
            void header.getBoundingClientRect();
            header.classList.add('captured');
            window.setTimeout(() => {
              header.classList.remove('captured');
              resolve('Dream held safely');
            }, reducedMotion ? 0 : 900);
          }, reducedMotion ? 0 : 260);
        });
      };
    })();
  ]]></script>
</svg>
